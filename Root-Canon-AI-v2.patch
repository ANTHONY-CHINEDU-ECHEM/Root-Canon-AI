+"""Version controlled clinical knowledge used by deterministic components.
+
+Each YAML file here is reviewed like code: the lexicon used for query
+understanding, the medication safety rules, and the guideline supersession
+graph. Loading is cached and validated so a malformed edit fails at start up
+rather than silently during a consultation.
+"""
+
+from __future__ import annotations
+
+from functools import lru_cache
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+KNOWLEDGE_DIR = Path(__file__).parent
+
+
+@lru_cache(maxsize=8)
+def load(name: str) -> dict[str, Any]:
+    path = KNOWLEDGE_DIR / f"{name}.yaml"
+    data = yaml.safe_load(path.read_text(encoding="utf-8"))
+    if not isinstance(data, dict):
+        raise ValueError(f"{path} must contain a mapping at the top level")
+    return data
