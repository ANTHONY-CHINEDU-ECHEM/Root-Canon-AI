-"""Assemble README.md from docs/README.template.md and docs/architecture.mmd.
+"""Keep README.md and docs/architecture.mmd in step, and enforce the README style.
 
-Keeping the Mermaid source in one file means the README diagram and the
-standalone diagram can never drift apart. The README is checked in CI for
-hyphens and dashes, so this script refuses to write one that contains any.
+The README carries the system architecture diagram inline, and the same Mermaid
+source lives in docs/architecture.mmd for slides and other renderers. This
+script:
+
+  * with no flags, writes the diagram from docs/architecture.mmd into the
+    README's mermaid block, leaving every other line untouched;
+  * with --check (used in CI), fails if the two have drifted apart, or if the
+    README prose contains hyphens or dashes, which the house style avoids.
+    Code blocks and the diagram are exempt from the style rule.
+
+    python -m scripts.build_readme           # sync the diagram into the README
+    python -m scripts.build_readme --check   # verify only
 """
 
 from __future__ import annotations
 
+import argparse
 import re
+import sys
 from pathlib import Path
 
 ROOT = Path(__file__).resolve().parents[1]
+README = ROOT / "README.md"
+DIAGRAM = ROOT / "docs" / "architecture.mmd"
+_BLOCK = re.compile(r"```mermaid\n(.*?)\n```", re.DOTALL)
+_DASH = re.compile("[—–-]")
+
+
+def prose_violations(markdown: str) -> list[tuple[int, str]]:
+    bad, fenced = [], False
+    for number, line in enumerate(markdown.splitlines(), start=1):
+        if line.startswith("```"):
+            fenced = not fenced
+            continue
+        if not fenced and _DASH.search(line):
+            bad.append((number, line))
+    return bad
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args(argv)
+
+    readme = README.read_text(encoding="utf-8")
+    diagram = DIAGRAM.read_text(encoding="utf-8").strip()
+    match = _BLOCK.search(readme)
+    if not match:
+        print("README.md has no mermaid block", file=sys.stderr)
+        return 1
+
+    problems = []
+    if match.group(1).strip() != diagram:
+        problems.append("README diagram differs from docs/architecture.mmd (run: make readme)")
+    problems += [f"line {n} uses a hyphen or dash: {text}" for n, text in prose_violations(readme)]
 
+    if args.check:
+        if problems:
+            print("README check failed:\n  " + "\n  ".join(problems), file=sys.stderr)
+            return 1
+        print("README check passed")
+        return 0
 
