diff --git a/backend/app/llm/base.py b/backend/app/llm/base.py
new file mode 100644
index 0000000..0385634
--- /dev/null
+++ b/backend/app/llm/base.py
@@ -0,0 +1,55 @@
+"""Provider neutral language model interface.
+
+Every vendor (Anthropic, OpenAI, Ollama) and the offline extractive generator
+implement the same two calls, so retrieval, guardrails and citation checks are
+identical whichever model is selected.
+"""
+
+from __future__ import annotations
+
+import abc
+from collections.abc import AsyncIterator
+from dataclasses import dataclass
+from typing import Literal
+
+
+class LLMUnavailableError(RuntimeError):
+    """Raised when a provider cannot serve a request (missing key, outage, timeout).
+
+    The pipeline treats this as a signal to fall through to the next provider in
+    the fallback chain, ending at the extractive generator which never fails.
+    """
+
+
+@dataclass(frozen=True)
+class LLMMessage:
+    role: Literal["user", "assistant"]
+    content: str
+
+
+@dataclass(frozen=True)
+class LLMResponse:
+    text: str
+    model: str
+    provider: str
+    input_tokens: int = 0
+    output_tokens: int = 0
+    stop_reason: str | None = None
+
+
+class LLMProvider(abc.ABC):
+    name: str = "base"
+    model: str = "unknown"
+
+    @abc.abstractmethod
+    async def complete(self, system: str, messages: list[LLMMessage], *,
+                       temperature: float, max_tokens: int) -> LLMResponse:
+        """Return the whole completion."""
+
+    @abc.abstractmethod
+    def stream(self, system: str, messages: list[LLMMessage], *,
+               temperature: float, max_tokens: int) -> AsyncIterator[str]:
+        """Yield text fragments as they are produced."""
+
+    async def health(self) -> bool:
+        return True
