diff --git a/backend/app/audit.py b/backend/app/audit.py
new file mode 100644
index 0000000..3455f49
--- /dev/null
+++ b/backend/app/audit.py
@@ -0,0 +1,138 @@
+"""Audit trail and clinician feedback.
+
+Every answer is recorded without patient text: the question is stored only as a
+keyed hash (HMAC with a deployment secret, so common questions cannot be
+recovered by hashing a dictionary of guesses), alongside the sources used, the
+safety checks and the provider. Feedback is linked to an answer by its request
+id, and any free text comment is redacted before it is written.
+
+`summarise` turns both logs into the figures a clinical safety officer reviews:
+abstention and grounding rates, coverage and faithfulness, emergencies, tool use,
+superseded sources and the share of negative feedback.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import json
+import statistics
+import time
+from collections import Counter
+from pathlib import Path
+from threading import Lock
+from typing import Any
+
+from backend.app.guardrails import pii
+
+_LOCK = Lock()
+
+
+def question_hash(question: str, salt: str) -> str:
+    return hmac.new(salt.encode(), question.strip().lower().encode(), hashlib.sha256).hexdigest()
+
+
+class AuditLog:
+    def __init__(self, directory: Path, salt: str) -> None:
+        self.directory = directory
+        self.salt = salt
+
+    @property
+    def answers_path(self) -> Path:
+        return self.directory / "answers.jsonl"
+
+    @property
+    def feedback_path(self) -> Path:
+        return self.directory / "feedback.jsonl"
+
+    def _append(self, path: Path, record: dict) -> None:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        line = json.dumps(record, ensure_ascii=False) + "\n"
+        with _LOCK, path.open("a", encoding="utf-8") as handle:
+            handle.write(line)
+
+    def record_answer(self, result: Any, question: str) -> None:
+        self._append(self.answers_path, {
+            "request_id": result.request_id,
+            "question_hmac": question_hash(question, self.salt),
+            "sources": [s.url for s in result.sources],
+            "superseded_sources": [s.url for s in result.sources if s.superseded_by],
+            "abstained": result.abstained,
+            "out_of_scope": result.out_of_scope,
+            "grounded": result.grounded,
+            "coverage": result.citation_coverage,
+            "faithfulness": result.faithfulness,
+            "unsupported_numbers": result.unsupported_numbers,
+            "emergency": bool(result.emergency_banner),
+            "tools": [c["tool"] for c in result.tool_cards],
+            "safety_flags": [f["severity"] for c in result.tool_cards if c["tool"] == "safety_screen"
+                             for f in c["data"].get("flags", [])],
+            "provider": result.provider,
+            "model": result.model,
+            "latency_ms": result.latency_ms,
+            "ts": time.time(),
+        })
+
+    def record_feedback(self, request_id: str, rating: str, reasons: list[str], comment: str | None) -> dict:
+        redaction = pii.redact(comment) if comment else None
+        record = {
+            "request_id": request_id,
+            "rating": rating,
+            "reasons": reasons,
+            "comment": redaction.text if redaction else None,
+            "comment_redactions": redaction.found if redaction else {},
+            "ts": time.time(),
+        }
+        self._append(self.feedback_path, record)
+        return record
+
+    @staticmethod
+    def _read(path: Path, since: float | None) -> list[dict]:
+        if not path.exists():
+            return []
+        rows = []
+        with path.open(encoding="utf-8") as handle:
+            for line in handle:
+                if line.strip():
+                    try:
+                        row = json.loads(line)
+                    except json.JSONDecodeError:
+                        continue
+                    if since is None or row.get("ts", 0) >= since:
+                        rows.append(row)
+        return rows
+
+    def summarise(self, since: float | None = None) -> dict:
+        answers = self._read(self.answers_path, since)
+        feedback = self._read(self.feedback_path, since)
+        answered = [a for a in answers if not a.get("abstained") and not a.get("out_of_scope")]
+
+        def rate(rows: list[dict], key: str) -> float:
+            return round(sum(bool(r.get(key)) for r in rows) / len(rows), 3) if rows else 0.0
+
+        def mean(rows: list[dict], key: str) -> float | None:
+            values = [r[key] for r in rows if isinstance(r.get(key), int | float)]
+            return round(statistics.mean(values), 3) if values else None
+
+        latencies = sorted(a["latency_ms"] for a in answers if "latency_ms" in a)
+        ratings = Counter(f["rating"] for f in feedback)
+        return {
+            "answers": len(answers),
+            "answered": len(answered),
+            "abstention_rate": rate(answers, "abstained"),
+            "out_of_scope_rate": rate(answers, "out_of_scope"),
+            "grounded_rate": rate(answered, "grounded"),
+            "mean_citation_coverage": mean(answered, "coverage"),
+            "mean_faithfulness": mean(answered, "faithfulness"),
+            "answers_with_unsupported_figures": sum(bool(a.get("unsupported_numbers")) for a in answers),
+            "emergencies": sum(bool(a.get("emergency")) for a in answers),
+            "answers_citing_superseded_guidance": sum(bool(a.get("superseded_sources")) for a in answers),
+            "tool_cards": dict(Counter(t for a in answers for t in a.get("tools", []))),
+            "safety_flags": dict(Counter(s for a in answers for s in a.get("safety_flags", []))),
+            "providers": dict(Counter(a.get("provider", "unknown") for a in answers)),
+            "latency_ms_p50": latencies[len(latencies) // 2] if latencies else None,
+            "latency_ms_p95": latencies[min(len(latencies) - 1, int(len(latencies) * 0.95))] if latencies else None,
+            "feedback": {"total": len(feedback), **ratings,
+                         "negative_rate": round(ratings.get("down", 0) / len(feedback), 3) if feedback else 0.0,
+                         "reasons": dict(Counter(r for f in feedback for r in f.get("reasons", [])))},
+        }
diff --git a/backend/app/cache.py b/backend/app/cache.py
new file mode 100644
index 0000000..a6e1aaa
--- /dev/null
+++ b/backend/app/cache.py
@@ -0,0 +1,108 @@
+"""Answer cache.
+
+Redis is used when it is reachable so every API replica shares the cache. When
+it is not, a bounded in process LRU with per entry expiry takes over, which
+keeps single instance and development deployments fast without a dependency.
+
+Only redacted, grounded, non emergency answers are cached (the routes decide
+that), and keys are hashes of the redacted request, so no patient identifier
+can appear in a cache key or value.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import time
+from collections import OrderedDict
+from threading import Lock
+from typing import Protocol
+
+from backend.app.logging_setup import get_logger
+from backend.app.observability import metrics
+
+log = get_logger("cache")
+
+
+class AnswerCache(Protocol):
+    backend: str
+
+    def get(self, key: str) -> str | None: ...
+
+    def set(self, key: str, value: str, ttl_seconds: int) -> None: ...
+
+
+def cache_key(*parts: object) -> str:
+    return "rc:answer:v2:" + hashlib.sha256(json.dumps(parts, sort_keys=True, default=str).encode()).hexdigest()
+
+
+class MemoryCache:
+    backend = "memory"
+
+    def __init__(self, max_entries: int = 512, clock=time.monotonic) -> None:  # type: ignore[no-untyped-def]
+        self.max_entries = max_entries
+        self._clock = clock
+        self._data: OrderedDict[str, tuple[float, str]] = OrderedDict()
+        self._lock = Lock()
+
+    def get(self, key: str) -> str | None:
+        with self._lock:
+            item = self._data.get(key)
+            if item is None:
+                metrics.CACHE.labels("miss").inc()
+                return None
+            expires, value = item
+            if expires < self._clock():
+                del self._data[key]
+                metrics.CACHE.labels("expired").inc()
+                return None
+            self._data.move_to_end(key)
+            metrics.CACHE.labels("hit").inc()
+            return value
+
+    def set(self, key: str, value: str, ttl_seconds: int) -> None:
+        with self._lock:
+            self._data[key] = (self._clock() + ttl_seconds, value)
+            self._data.move_to_end(key)
+            while len(self._data) > self.max_entries:
+                self._data.popitem(last=False)
+
+    def __len__(self) -> int:
+        return len(self._data)
+
+
+class RedisCache:
+    backend = "redis"
+
+    def __init__(self, client) -> None:  # type: ignore[no-untyped-def]
+        self.client = client
+
+    def get(self, key: str) -> str | None:
+        try:
+            value = self.client.get(key)
+        except Exception as exc:
+            log.warning("cache_get_failed", error=str(exc))
+            return None
+        metrics.CACHE.labels("hit" if value else "miss").inc()
+        return value.decode() if isinstance(value, bytes) else value
+
+    def set(self, key: str, value: str, ttl_seconds: int) -> None:
+        try:
+            self.client.setex(key, ttl_seconds, value)
+        except Exception as exc:
+            log.warning("cache_set_failed", error=str(exc))
+
+
+def build_cache(redis_url: str | None, memory_size: int = 512) -> AnswerCache | None:
+    if memory_size <= 0 and not redis_url:
+        return None
+    if redis_url:
+        try:
+            import redis
+
+            client = redis.Redis.from_url(redis_url, socket_connect_timeout=1, socket_timeout=1)
+            client.ping()
+            return RedisCache(client)
+        except Exception as exc:
+            log.info("redis_unavailable_using_memory_cache", error=str(exc))
+    return MemoryCache(memory_size) if memory_size > 0 else None
diff --git a/backend/app/clinical/entities.py b/backend/app/clinical/entities.py
new file mode 100644
index 0000000..e8f1291
--- /dev/null
+++ b/backend/app/clinical/entities.py
@@ -0,0 +1,149 @@
+"""Clinical query understanding.
+
+Turns free text such as "Pt on Eliquis, 6 yr old needs amoxil, how much?" into
+structured facts the rest of the system can act on deterministically:
+
+  * a normalised query with UK spelling and generic drug names, used for
+    retrieval so "Xarelto" finds guidance that only says "rivaroxaban";
+  * the medicines mentioned, with their drug classes;
+  * the patient's age and weight when stated;
+  * the intents present (dose, maximum dose, interaction, referral, ...).
+
+Everything here is rule based and reviewed in `knowledge/lexicon.yaml`; no
+model is involved, so extraction is reproducible and testable.
+"""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from functools import lru_cache
+
+from backend.app.knowledge import load
+
+_AGE_PATTERNS: tuple[tuple[re.Pattern[str], float], ...] = (
+    # "18 month old", "6-month-old"
+    (re.compile(r"\b(\d{1,2})[\s-]*(?:months?|mths?)[\s-]*old\b", re.I), 1 / 12),
+    # "3 year old", "3-year-old", "45 yrs old"
+    (re.compile(r"\b(\d{1,3}(?:\.\d)?)[\s-]*(?:years?|yrs?|yr)[\s-]*old\b", re.I), 1.0),
+    # "45yo", "45 y/o"
+    (re.compile(r"\b(\d{1,3})\s*(?:yo|y/o|y\.o\.)(?![a-z])", re.I), 1.0),
+    # "aged 9 months", "age: 9 months"
+    (re.compile(r"\b(?:aged?)[:\s]+(\d{1,2})\s*(?:months?|mths?)\b", re.I), 1 / 12),
+    # "aged 7", "age 7", "age: 70 years"
+    (re.compile(r"\b(?:aged?)[:\s]+(\d{1,3}(?:\.\d)?)\b(?!\s*(?:months?|mths?|kg|mg))", re.I), 1.0),
+)
+_WEIGHT = re.compile(r"\b(\d{1,3}(?:\.\d)?)\s*(?:kg|kilograms?|kilos?)\b", re.I)
+_CHILD_WORDS = re.compile(r"\b(child|children|paediatric|pediatric|infant|toddler|baby|kid)\b", re.I)
+
+
+@dataclass(frozen=True)
+class ClinicalEntities:
+    original: str
+    normalised: str
+    drugs: tuple[str, ...] = ()
+    classes: frozenset[str] = field(default_factory=frozenset)
+    age_years: float | None = None
+    weight_kg: float | None = None
+    intents: frozenset[str] = field(default_factory=frozenset)
+    mentions_child: bool = False
+
+    @property
+    def expansion(self) -> str:
+        """Generic names to append to the retrieval query (only ones not already present)."""
+        lowered = self.original.lower()
+        return " ".join(d for d in self.drugs if d not in lowered)
+
+    def as_dict(self) -> dict:
+        return {
+            "drugs": list(self.drugs),
+            "classes": sorted(self.classes),
+            "age_years": self.age_years,
+            "weight_kg": self.weight_kg,
+            "intents": sorted(self.intents),
+            "normalised": self.normalised,
+        }
+
+
+@lru_cache(maxsize=1)
+def _lexicon() -> tuple[list[tuple[re.Pattern[str], str]], list[tuple[re.Pattern[str], str]],
+                        dict[str, set[str]], list[tuple[re.Pattern[str], str]], dict[str, list[str]]]:
+    data = load("lexicon")
+    # Longest names first so "penicillin v" wins over any shorter overlap.
+    synonyms = sorted(data["synonyms"].items(), key=lambda kv: -len(kv[0]))
+    synonym_patterns = [(re.compile(rf"\b{re.escape(k)}\b", re.I), v) for k, v in synonyms]
+    spelling_patterns = [(re.compile(rf"\b{re.escape(us)}", re.I), uk) for us, uk in data["spellings"].items()]
+    class_of: dict[str, set[str]] = {}
+    for cls, members in data["drug_classes"].items():
+        for member in members:
+            class_of.setdefault(member, set()).add(cls)
+    generic_patterns = [(re.compile(rf"\b{re.escape(name)}\b", re.I), name)
+                        for name in sorted(class_of, key=lambda n: -len(n))]
+    return synonym_patterns, spelling_patterns, class_of, generic_patterns, data["intents"]
+
+
+def normalise(text: str) -> str:
+    """UK spelling and generic names, preserving the rest of the text exactly."""
+    synonym_patterns, spelling_patterns, *_ = _lexicon()
+    for pattern, target in spelling_patterns:
+        text = pattern.sub(_case_preserving(target), text)
+    for pattern, generic in synonym_patterns:
+        text = pattern.sub(generic, text)
+    return text
+
+
+def _case_preserving(replacement: str) -> Callable[[re.Match[str]], str]:
+    def replace(match: re.Match[str]) -> str:
+        return replacement.capitalize() if match.group(0)[:1].isupper() else replacement
+
+    return replace
+
+
+def _age(text: str) -> float | None:
+    for pattern, scale in _AGE_PATTERNS:
+        match = pattern.search(text)
+        if match:
+            value = float(match.group(1)) * scale
+            if 0 <= value <= 120:
+                return round(value, 2)
+    return None
+
+
+def _weight(text: str) -> float | None:
+    match = _WEIGHT.search(text)
+    if match:
+        value = float(match.group(1))
+        if 1 <= value <= 300:
+            return value
+    return None
+
+
+def extract(text: str) -> ClinicalEntities:
+    _, _, class_of, generic_patterns, intents = _lexicon()
+    normalised = normalise(text)
+    lowered = normalised.lower()
+
+    drugs: list[str] = []
+    for pattern, name in generic_patterns:
+        if pattern.search(normalised) and not any(name in found for found in drugs):
+            drugs.append(name)
+    # Keep the order in which the clinician mentioned them.
+    drugs.sort(key=lambda d: lowered.find(d))
+    classes = frozenset(cls for d in drugs for cls in class_of.get(d, ()))
+    found_intents = frozenset(name for name, cues in intents.items() if any(cue in lowered for cue in cues))
+
+    return ClinicalEntities(
+        original=text,
+        normalised=normalised,
+        drugs=tuple(drugs),
+        classes=classes,
+        age_years=_age(normalised),
+        weight_kg=_weight(normalised),
+        intents=found_intents,
+        mentions_child=bool(_CHILD_WORDS.search(normalised)),
+    )
+
+
+def drug_class_members(cls: str) -> list[str]:
+    return list(load("lexicon")["drug_classes"].get(cls, []))
