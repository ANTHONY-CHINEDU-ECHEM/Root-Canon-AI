+# Root Canon AI: every common task. Run `make help` for the list.
+PY ?= python
+NPM ?= npm
+COMPOSE ?= docker compose
+
+.DEFAULT_GOAL := help
+.PHONY: help install install_dev seed serve frontend up down logs ingest ingest_quick reindex stats \
+        test lint format typecheck eval eval_gate eval_live check demo_build readme diagram ask clean
+
+help: ## Show this list
+	@grep -E '^[a-z_]+:.*##' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  \033[1m%-14s\033[0m %s\n", $$1, $$2}'
+
+install: ## Python (all extras) and frontend dependencies
+	$(PY) -m pip install -e ".[all,dev]"
+	cd frontend && $(NPM) ci
+
+install_dev: ## Lightweight install for offline development and CI (no model weights)
+	$(PY) -m pip install -e ".[dev]"
+
+seed: ## Index the bundled UK guidance seed set in seconds
+	$(PY) -m ingestion.cli seed
+
+serve: ## API on port 8000 with reload
+	$(PY) -m uvicorn backend.app.main:app --reload --port 8000
+
+frontend: ## Clinician interface on port 5173
+	cd frontend && $(NPM) run dev
+
+up: ## Full stack in containers: API, Qdrant, Redis, interface, Prometheus, Grafana
+	$(COMPOSE) up -d --build
+
+down: ## Stop the stack
+	$(COMPOSE) down
+
+logs: ## Follow API logs
+	$(COMPOSE) logs -f api
+
+ingest: ## Harvest every source into the index (several hours)
+	$(PY) -m ingestion.cli ingest --sources all
+
+ingest_quick: ## Capped harvest for development
+	$(PY) -m ingestion.cli ingest --sources all --limit 200
+
+reindex: ## Rebuild the indexes from data/raw without calling any API
+	$(PY) -m ingestion.cli ingest --from-raw
+
+stats: ## Print the current index manifest
+	$(PY) -m ingestion.cli stats
+
+test: ## Unit, pipeline and API tests with coverage
+	$(PY) -m pytest --cov --cov-report=term --cov-report=xml
+
+lint: ## Ruff lint and README style gate
+	$(PY) -m ruff check backend ingestion evaluation scripts tests
+	$(PY) -m scripts.build_readme --check
+
+format: ## Apply safe lint fixes
+	$(PY) -m ruff check --fix backend ingestion evaluation scripts tests
+
+typecheck: ## Mypy over the Python packages, tsc over the interface
+	$(PY) -m mypy
+	cd frontend && $(NPM) run typecheck
+
+eval: ## Offline evaluation report (seed index, extractive generator)
+	$(PY) -m evaluation.run_eval --markdown evaluation/results/latest.md
+
+eval_gate: ## Offline evaluation that fails on any threshold in evaluation/thresholds.yaml
+	$(PY) -m evaluation.run_eval --gate --markdown evaluation/results/latest.md
+
+eval_live: ## Evaluation against the live index and Claude, with a model judge
+	$(PY) -m evaluation.run_eval --provider anthropic --judge anthropic --out evaluation/results/live.json \
+		--markdown evaluation/results/live.md
+
+check: lint typecheck test eval_gate ## Everything CI runs
+
+demo_build: ## Rebuild the standalone demo page from the seed corpus
+	$(PY) -m scripts.build_demo
+
+readme: ## Rebuild README.md from docs/README.template.md, keeping the diagram in sync
+	$(PY) -m scripts.build_readme
+
+diagram: ## Regenerate docs/architecture.svg
+	$(PY) -m scripts.draw_architecture
+
+ask: ## Ask from the terminal, e.g. make ask Q="amoxicillin dose for a 3 year old"
+	$(PY) -m backend.app.cli ask "$(Q)"
+
+clean: ## Remove caches and build output
+	rm -rf .pytest_cache .mypy_cache .ruff_cache htmlcov coverage.xml frontend/dist
diff --git a/backend/app/cli.py b/backend/app/cli.py
new file mode 100644
index 0000000..75c48cc
--- /dev/null
+++ b/backend/app/cli.py
@@ -0,0 +1,121 @@
+"""Command line access to the assistant and the clinical tools.
+
+Examples
+    root-canon ask "Amoxicillin dose for a 3 year old with a dental abscess"
+    root-canon ask "Can I give ibuprofen?" --context "Takes apixaban, asthma"
+    root-canon screen --planned ibuprofen --current Xarelto --context "asthma"
+    root-canon understand "max articaine for a 22 kg child"
+    root-canon serve --port 8000
+
+`ask` uses the configured index and providers; with no index built it falls back
+to the bundled seed set in memory, so the command works straight after cloning.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import sys
+import textwrap
+from dataclasses import asdict
+
+from backend.app.config import get_settings
+
+
+def _pipeline():  # type: ignore[no-untyped-def]
+    settings = get_settings()
+    if settings.vector_backend == "memory" and not (settings.index_dir / "bm25.pkl").exists():
+        from evaluation.run_eval import offline_pipeline
+
+        offline = settings.model_copy(update={"embedding_backend": "hashing", "reranker_backend": "none",
+                                              "min_evidence_score": 0.1})
+        return offline_pipeline(offline)
+    from backend.app.api.deps import build_container
+
+    return build_container(settings).pipeline
+
+
+def _print_answer(result, as_json: bool) -> None:  # type: ignore[no-untyped-def]
+    if as_json:
+        print(json.dumps(asdict(result), indent=2, default=str))
+        return
+    if result.emergency_banner:
+        print(f"\n!! EMERGENCY: {result.emergency_banner}\n")
+    for card in result.tool_cards:
+        severity = f" [{card['severity']}]" if card.get("severity") else ""
+        print(f"[{card['tool']}]{severity} {card['title']}: {card['summary']}")
+    if result.tool_cards:
+        print()
+    print(result.answer)
+    if result.sources:
+        print("\nSources")
+        for s in result.sources:
+            flag = "  (superseded)" if s.superseded_by else ""
+            print(f"  [{s.id}] {textwrap.shorten(s.title, 90)} ({s.evidence}, {s.year or 'n/a'}){flag}\n      {s.url}")
+    faith = "n/a" if result.faithfulness is None else f"{result.faithfulness:.2f}"
+    print(f"\ncoverage {result.citation_coverage:.2f} · faithfulness {faith} · grounded {result.grounded} · "
+          f"{result.provider} · {result.latency_ms:.0f} ms")
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="root-canon", description="Root Canon AI from the command line.")
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    ask = sub.add_parser("ask", help="Ask a clinical question")
+    ask.add_argument("question")
+    ask.add_argument("--context", default=None, help="De identified patient context")
+    ask.add_argument("--provider", choices=["anthropic", "openai", "ollama"], default=None)
+    ask.add_argument("--json", action="store_true")
+
+    understand = sub.add_parser("understand", help="Show entities, triage and tool routing for a question")
+    understand.add_argument("question")
+    understand.add_argument("--context", default=None)
+
+    screen = sub.add_parser("screen", help="Medication safety screen")
+    screen.add_argument("--planned", nargs="+", required=True)
+    screen.add_argument("--current", nargs="*", default=[])
+    screen.add_argument("--context", default=None)
+
+    serve = sub.add_parser("serve", help="Run the API")
+    serve.add_argument("--host", default="127.0.0.1")
+    serve.add_argument("--port", type=int, default=8000)
+    serve.add_argument("--reload", action="store_true")
+
+    args = parser.parse_args(argv)
+
+    if args.command == "ask":
+        from backend.app.logging_setup import configure_logging
+
+        configure_logging("WARNING")
+        pipeline = _pipeline()
+        if args.provider:
+            from backend.app.llm.factory import build_router
+
+            pipeline.provider = build_router(pipeline.settings, args.provider)
+        result = asyncio.run(pipeline.answer(args.question, patient_context=args.context))
+        _print_answer(result, args.json)
+    elif args.command == "understand":
+        from backend.app.clinical import entities
+        from backend.app.clinical import router as tool_router
+        from backend.app.guardrails import emergency, pii
+
+        question = pii.redact(args.question).text
+        triage = emergency.assess(question)
+        cards = tool_router.route(question, args.context, any(r.code == "anaphylaxis" for r in triage.rules))
+        print(json.dumps({"entities": entities.extract(question).as_dict(),
+                          "emergency": [r.code for r in triage.rules],
+                          "tool_cards": [c.as_dict() for c in cards]}, indent=2))
+    elif args.command == "screen":
+        from backend.app.clinical import safety_screen
+
+        print(json.dumps(safety_screen.screen(args.planned, args.current, args.context).as_dict(), indent=2))
+    elif args.command == "serve":
+        import uvicorn
+
+        uvicorn.run("backend.app.main:app", host=args.host, port=args.port, reload=args.reload)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
