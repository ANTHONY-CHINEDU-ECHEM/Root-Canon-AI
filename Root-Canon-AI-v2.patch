+const DATA = {"chunks": [{"doc_id": "seed:sdcep-amoxicillin", "title": "SDCEP Drug Prescribing for Dentistry: Amoxicillin for dental abscess", "section": "Role", "text": "Amoxicillin is an effective first line antibiotic for a dental abscess and is absorbed better than phenoxymethylpenicillin. Patients who have completed a course of antibiotic treatment should be reviewed.", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/bacterial-infections/dental-abscess/first-line-antibiotics/amoxicillin", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-amoxicillin", "title": "SDCEP Drug Prescribing for Dentistry: Amoxicillin for dental abscess", "section": "Adult Regimen", "text": "For adults the suggested 5 day regimen is amoxicillin 500 mg capsules, one capsule three times daily, supplying 15 capsules.", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/bacterial-infections/dental-abscess/first-line-antibiotics/amoxicillin", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-amoxicillin", "title": "SDCEP Drug Prescribing for Dentistry: Amoxicillin for dental abscess", "section": "Paediatric Regimen", "text": "For children the dose is set by age: 6 to 11 months 125 mg three times daily; 1 to 4 years 250 mg three times daily; 5 to 11 years 500 mg three times daily; 12 to 17 years 500 mg three times daily. Capsules of 250 mg or oral suspension of 125 mg/5 ml or 250 mg/5 ml may be used.", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/bacterial-infections/dental-abscess/first-line-antibiotics/amoxicillin", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-2021-update", "title": "SDCEP Drug Prescribing for Dentistry: 2021 update on antibiotic choice", "section": "First Choice Antibiotic", "text": "The 2021 update to the third edition, aligned with BNF 81, makes phenoxymethylpenicillin the preferred first choice antibiotic for dento alveolar infections because its narrower spectrum is less likely to drive antimicrobial resistance. The suggested adult regimen is phenoxymethylpenicillin 500 mg four times daily for 5 days.", "url": "https://sdcep.org.uk/news/update-to-drug-prescribing-guidance-now-available/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-2021-update", "title": "SDCEP Drug Prescribing for Dentistry: 2021 update on antibiotic choice", "section": "When To Prescribe", "text": "The situations in which an antibiotic is appropriate are unchanged. Local measures such as drainage, extraction or pulp extirpation should be used first, and antibiotics are reserved for spreading infection or systemic involvement such as fever or lymphadenopathy.", "url": "https://sdcep.org.uk/news/update-to-drug-prescribing-guidance-now-available/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-metronidazole", "title": "SDCEP Drug Prescribing for Dentistry: Metronidazole for acute periodontal conditions", "section": "Indication", "text": "Metronidazole is used for necrotising periodontal conditions when there is systemic involvement or local measures alone are insufficient, alongside debridement and oral hygiene instruction. It is also an option for dental abscess in penicillin allergy.", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/bacterial-infections/acute-periodontal-conditions/metronidazole/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-metronidazole", "title": "SDCEP Drug Prescribing for Dentistry: Metronidazole for acute periodontal conditions", "section": "Adult Regimen", "text": "The adult regimen is metronidazole 400 mg three times daily for 3 days for necrotising periodontal disease. The 2021 update set the adult dental abscess regimen at 400 mg three times daily for 5 days.", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/bacterial-infections/acute-periodontal-conditions/metronidazole/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-metronidazole", "title": "SDCEP Drug Prescribing for Dentistry: Metronidazole for acute periodontal conditions", "section": "Cautions", "text": "Patients must avoid alcohol during the course and for 48 hours afterwards because of a disulfiram like reaction. Metronidazole enhances the anticoagulant effect of warfarin.", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/bacterial-infections/acute-periodontal-conditions/metronidazole/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-ibuprofen", "title": "SDCEP Drug Prescribing for Dentistry: Ibuprofen for odontogenic pain", "section": "Regimen", "text": "For adults with dental pain the suggested regimen is ibuprofen 400 mg four times daily, preferably after food, for up to 5 days.", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/odontogenic-pain/analgesics/ibuprofen/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-ibuprofen", "title": "SDCEP Drug Prescribing for Dentistry: Ibuprofen for odontogenic pain", "section": "Cautions", "text": "Non steroidal anti inflammatory drugs should be avoided or used with caution in patients with asthma worsened by NSAIDs, a history of peptic ulceration, renal impairment, heart failure, late pregnancy, and in those taking anticoagulants, where paracetamol is preferred.", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/odontogenic-pain/analgesics/ibuprofen/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-paracetamol", "title": "SDCEP Drug Prescribing for Dentistry: Paracetamol for odontogenic pain", "section": "Regimen", "text": "For adults the suggested regimen is paracetamol 1 g four times daily for up to 5 days, with a maximum of 4 g in 24 hours.", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/odontogenic-pain/analgesics/paracetamol/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-paracetamol", "title": "SDCEP Drug Prescribing for Dentistry: Paracetamol for odontogenic pain", "section": "Cautions", "text": "A lower dose is needed for adults weighing under 50 kg and for patients with hepatic impairment or chronic alcohol dependence. Paracetamol is the analgesic of choice for patients taking anticoagulants.", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/odontogenic-pain/analgesics/paracetamol/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:nice-cg64", "title": "NICE CG64: Prophylaxis against infective endocarditis", "section": "Recommendation", "text": "Antibiotic prophylaxis against infective endocarditis is not recommended routinely for people undergoing dental procedures. Chlorhexidine mouthwash should not be offered as prophylaxis against infective endocarditis.", "url": "https://www.nice.org.uk/guidance/cg64", "evidence_level": 6, "evidence": "UK national guidance", "year": 2016, "jurisdiction": "UK"}, {"doc_id": "seed:nice-cg64", "title": "NICE CG64: Prophylaxis against infective endocarditis", "section": "2016 Amendment", "text": "In 2016 NICE added the word routinely to the recommendation, acknowledging that in individual cases prophylaxis may be appropriate after discussion with the patient and their cardiology team.", "url": "https://www.nice.org.uk/guidance/cg64", "evidence_level": 6, "evidence": "UK national guidance", "year": 2016, "jurisdiction": "UK"}, {"doc_id": "seed:nice-cg64", "title": "NICE CG64: Prophylaxis against infective endocarditis", "section": "Infection Management", "text": "Any episode of infection in people at risk of infective endocarditis should be investigated and treated promptly to reduce the risk of endocarditis.", "url": "https://www.nice.org.uk/guidance/cg64", "evidence_level": 6, "evidence": "UK national guidance", "year": 2016, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-ie", "title": "SDCEP: Antibiotic prophylaxis against infective endocarditis implementation advice", "section": "Special Risk Patients", "text": "Patients at increased risk include those with a prosthetic valve or prior valve repair with prosthetic material, previous infective endocarditis, and some congenital heart disease. For these patients the need for prophylaxis before invasive procedures should be discussed with the cardiologist and the patient, and the decision recorded.", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/bacterial-infections/infective-endocarditis/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2018, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-ie", "title": "SDCEP: Antibiotic prophylaxis against infective endocarditis implementation advice", "section": "Regimen When Indicated", "text": "If prophylaxis is agreed for an adult, the regimen is amoxicillin 3 g orally 60 minutes before the procedure, or clindamycin 600 mg orally 60 minutes before the procedure for patients allergic to penicillin.", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/bacterial-infections/infective-endocarditis/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2018, "jurisdiction": "UK"}, {"doc_id": "seed:nice-cg19", "title": "NICE CG19: Dental checks, intervals between oral health reviews", "section": "Recall Interval", "text": "The interval between oral health reviews should be set for each patient after a risk assessment at every review. For adults it should range from a minimum of 3 months to a maximum of 24 months. For patients younger than 18 years it should range from 3 months to 12 months.", "url": "https://www.nice.org.uk/guidance/cg19", "evidence_level": 6, "evidence": "UK national guidance", "year": 2004, "jurisdiction": "UK"}, {"doc_id": "seed:nice-cg19", "title": "NICE CG19: Dental checks, intervals between oral health reviews", "section": "Risk Factors", "text": "The interval is informed by medical history, social history, dietary habits, fluoride exposure, clinical findings such as caries and periodontal status, and the patient's ability to maintain oral health.", "url": "https://www.nice.org.uk/guidance/cg19", "evidence_level": 6, "evidence": "UK national guidance", "year": 2004, "jurisdiction": "UK"}, {"doc_id": "seed:dboh-fluoride", "title": "Delivering better oral health: Chapter 9 fluoride", "section": "Toothpaste By Age", "text": "Children under 3 years should use a smear of toothpaste containing no less than 1,000 ppm fluoride. Children aged 3 to 6 years should use a pea sized amount containing more than 1,000 ppm fluoride. Children from 7 years and adults should use toothpaste containing 1,350 to 1,500 ppm fluoride, which is also advised for younger children at higher risk of caries.", "url": "https://www.gov.uk/government/publications/delivering-better-oral-health-an-evidence-based-toolkit-for-prevention/chapter-9-fluoride", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:dboh-fluoride", "title": "Delivering better oral health: Chapter 9 fluoride", "section": "Higher Concentration", "text": "The highest fluoride concentration sold over the counter in the UK is 1,500 ppm. Sodium fluoride 2,800 ppm toothpaste can be prescribed for patients aged 10 years and over, and 5,000 ppm toothpaste for patients aged 16 years and over, when caries risk is high. Risk should be reviewed at routine assessments.", "url": "https://www.gov.uk/government/publications/delivering-better-oral-health-an-evidence-based-toolkit-for-prevention/chapter-9-fluoride", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:dboh-fluoride", "title": "Delivering better oral health: Chapter 9 fluoride", "section": "Fluoride Varnish", "text": "Fluoride varnish at 22,600 ppm should be applied twice yearly for all children from 3 years, and two or more times a year for children and adults at higher risk of caries.", "url": "https://www.gov.uk/government/publications/delivering-better-oral-health-an-evidence-based-toolkit-for-prevention/chapter-9-fluoride", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-emergency-drugs", "title": "SDCEP Practice Support Manual: Medical emergency drugs", "section": "Required Drugs", "text": "Every dental practice must have immediate access to adrenaline 1 ml ampoules or prefilled syringes of 1:1000 solution for intramuscular injection, glyceryl trinitrate spray 400 micrograms per metered dose, salbutamol inhaler 100 micrograms per actuation, dispersible aspirin 300 mg, glucagon 1 mg for intramuscular injection, oral glucose, buccal midazolam, and medical oxygen.", "url": "https://www.psm.sdcep.org.uk/topics/medical-emergencies-and-life-support/medical-emergency-drugs/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-emergency-drugs", "title": "SDCEP Practice Support Manual: Medical emergency drugs", "section": "Who May Administer", "text": "The Prescription Only Medicines (Human Use) Order 1997 allows anyone to administer adrenaline and glucagon for the purpose of saving life in an emergency, so all trained dental team members may give them. Midazolam is a Schedule 3 controlled drug and its storage must comply with that legislation.", "url": "https://www.psm.sdcep.org.uk/topics/medical-emergencies-and-life-support/medical-emergency-drugs/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:rcuk-anaphylaxis", "title": "Resuscitation Council UK: Emergency treatment of anaphylaxis in dental practice", "section": "Adrenaline Dose", "text": "Give intramuscular adrenaline 1:1000 into the anterolateral thigh: 500 micrograms (0.5 mL) for adults and children over 12 years, 300 micrograms (0.3 mL) for children aged 6 to 12 years, and 150 micrograms (0.15 mL) for children under 6 years.", "url": "https://www.resus.org.uk/library/additional-guidance/guidance-anaphylaxis/emergency-treatment", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:rcuk-anaphylaxis", "title": "Resuscitation Council UK: Emergency treatment of anaphylaxis in dental practice", "section": "Repeat And Support", "text": "Repeat the dose after 5 minutes if there is no improvement. Call 999, follow the ABCDE approach, lie the patient flat with legs raised unless breathing is difficult, and give high flow oxygen.", "url": "https://www.resus.org.uk/library/additional-guidance/guidance-anaphylaxis/emergency-treatment", "evidence_level": 6, "evidence": "UK national guidance", "year": 2021, "jurisdiction": "UK"}, {"doc_id": "seed:scotgov-emergencies", "title": "Scottish Government: Emergency drugs and equipment in primary dental care", "section": "Emergencies To Prepare For", "text": "The BNF section on prescribing in dental practice lists the medical emergencies a dental team must be ready to manage: adrenal insufficiency, anaphylaxis, asthma, cardiac emergencies, epileptic seizures, hypoglycaemia and syncope. Aspiration, choking and stroke may also occur.", "url": "https://www.gov.scot/publications/emergency-drugs-equipment-primary-dental-care/pages/3/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2022, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-anticoagulants", "title": "SDCEP: Management of dental patients taking anticoagulants or antiplatelet drugs", "section": "Warfarin", "text": "For patients taking warfarin, check the INR ideally within 24 hours before treatment, or up to 72 hours before for patients with a stable INR. If the INR is below 4, treat without interrupting warfarin, using local haemostatic measures.", "url": "https://www.sdcep.org.uk/published-guidance/anticoagulants-and-antiplatelets/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2015, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-anticoagulants", "title": "SDCEP: Management of dental patients taking anticoagulants or antiplatelet drugs", "section": "Direct Oral Anticoagulants", "text": "For procedures with a low bleeding risk, treat without interrupting the drug. For procedures more likely to cause bleeding, patients taking apixaban or dabigatran twice daily should miss the morning dose, and patients taking rivaroxaban or edoxaban once daily in the morning should delay the dose until 4 hours after haemostasis.", "url": "https://www.sdcep.org.uk/published-guidance/anticoagulants-and-antiplatelets/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2015, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-anticoagulants", "title": "SDCEP: Management of dental patients taking anticoagulants or antiplatelet drugs", "section": "Antiplatelets", "text": "Antiplatelet drugs should not be interrupted before dental treatment. Expect prolonged bleeding and use local measures such as packing and suturing.", "url": "https://www.sdcep.org.uk/published-guidance/anticoagulants-and-antiplatelets/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2015, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-mronj", "title": "SDCEP: Oral health management of patients at risk of medication related osteonecrosis of the jaw", "section": "Risk Groups", "text": "Patients taking antiresorptive drugs such as bisphosphonates or denosumab for osteoporosis are generally at low risk of MRONJ. Patients treated with these drugs for cancer, or taking them with systemic glucocorticoids or for more than 5 years, are at higher risk.", "url": "https://www.sdcep.org.uk/published-guidance/medication-related-osteonecrosis-of-the-jaw/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2017, "jurisdiction": "UK"}, {"doc_id": "seed:sdcep-mronj", "title": "SDCEP: Oral health management of patients at risk of medication related osteonecrosis of the jaw", "section": "Management", "text": "Ideally make the patient dentally fit before antiresorptive therapy starts. Extractions for low risk patients can usually be performed in primary care. Do not advise patients to stop their antiresorptive drug; there is no evidence that a drug holiday reduces risk.", "url": "https://www.sdcep.org.uk/published-guidance/medication-related-osteonecrosis-of-the-jaw/", "evidence_level": 6, "evidence": "UK national guidance", "year": 2017, "jurisdiction": "UK"}, {"doc_id": "seed:nice-ng12-head-neck", "title": "NICE NG12: Suspected cancer recognition and referral, head and neck", "section": "Dental Referral", "text": "A dentist should consider an urgent referral, for an appointment within 2 weeks, for a lump on the lip or in the oral cavity, or a red or red and white patch in the oral cavity consistent with erythroplakia or erythroleukoplakia.", "url": "https://www.nice.org.uk/guidance/ng12", "evidence_level": 6, "evidence": "UK national guidance", "year": 2015, "jurisdiction": "UK"}, {"doc_id": "seed:nice-ng12-head-neck", "title": "NICE NG12: Suspected cancer recognition and referral, head and neck", "section": "General Practice Referral", "text": "Refer through a suspected cancer pathway for unexplained ulceration of the oral cavity lasting more than 3 weeks or a persistent and unexplained lump in the neck.", "url": "https://www.nice.org.uk/guidance/ng12", "evidence_level": 6, "evidence": "UK national guidance", "year": 2015, "jurisdiction": "UK"}, {"doc_id": "seed:bhvs-ie-review", "title": "A change in the NICE guidelines on antibiotic prophylaxis: British Heart Valve Society update", "section": "Summary", "text": "The British Heart Valve Society reviewed the 2016 change to NICE CG64. It explains that adding the word routinely allows clinicians to consider prophylaxis for selected high risk patients, and recommends that cardiologists and dentists agree a plan for those patients.", "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6172668/", "evidence_level": 1, "evidence": "Expert opinion or review", "year": 2018, "jurisdiction": "UK"}], "docs": [{"title": "SDCEP Drug Prescribing for Dentistry: Amoxicillin for dental abscess", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/bacterial-infections/dental-abscess/first-line-antibiotics/amoxicillin", "publisher": "Scottish Dental Clinical Effectiveness Programme", "year": 2021, "licence": "unknown", "evidence_level": 6, "evidence": "UK national guidance", "passages": 3}, {"title": "SDCEP Drug Prescribing for Dentistry: 2021 update on antibiotic choice", "url": "https://sdcep.org.uk/news/update-to-drug-prescribing-guidance-now-available/", "publisher": "Scottish Dental Clinical Effectiveness Programme", "year": 2021, "licence": "unknown", "evidence_level": 6, "evidence": "UK national guidance", "passages": 2}, {"title": "SDCEP Drug Prescribing for Dentistry: Metronidazole for acute periodontal conditions", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/bacterial-infections/acute-periodontal-conditions/metronidazole/", "publisher": "Scottish Dental Clinical Effectiveness Programme", "year": 2021, "licence": "unknown", "evidence_level": 6, "evidence": "UK national guidance", "passages": 3}, {"title": "SDCEP Drug Prescribing for Dentistry: Ibuprofen for odontogenic pain", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/odontogenic-pain/analgesics/ibuprofen/", "publisher": "Scottish Dental Clinical Effectiveness Programme", "year": 2021, "licence": "unknown", "evidence_level": 6, "evidence": "UK national guidance", "passages": 2}, {"title": "SDCEP Drug Prescribing for Dentistry: Paracetamol for odontogenic pain", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/odontogenic-pain/analgesics/paracetamol/", "publisher": "Scottish Dental Clinical Effectiveness Programme", "year": 2021, "licence": "unknown", "evidence_level": 6, "evidence": "UK national guidance", "passages": 2}, {"title": "NICE CG64: Prophylaxis against infective endocarditis", "url": "https://www.nice.org.uk/guidance/cg64", "publisher": "National Institute for Health and Care Excellence", "year": 2016, "licence": "syndication-licensed", "evidence_level": 6, "evidence": "UK national guidance", "passages": 3}, {"title": "SDCEP: Antibiotic prophylaxis against infective endocarditis implementation advice", "url": "https://sdcepdentalprescribing.nhs.scot/guidance/bacterial-infections/infective-endocarditis/", "publisher": "Scottish Dental Clinical Effectiveness Programme", "year": 2018, "licence": "unknown", "evidence_level": 6, "evidence": "UK national guidance", "passages": 2}, {"title": "NICE CG19: Dental checks, intervals between oral health reviews", "url": "https://www.nice.org.uk/guidance/cg19", "publisher": "National Institute for Health and Care Excellence", "year": 2004, "licence": "syndication-licensed", "evidence_level": 6, "evidence": "UK national guidance", "passages": 2}, {"title": "Delivering better oral health: Chapter 9 fluoride", "url": "https://www.gov.uk/government/publications/delivering-better-oral-health-an-evidence-based-toolkit-for-prevention/chapter-9-fluoride", "publisher": "Office for Health Improvement and Disparities", "year": 2021, "licence": "OGL-3.0", "evidence_level": 6, "evidence": "UK national guidance", "passages": 3}, {"title": "SDCEP Practice Support Manual: Medical emergency drugs", "url": "https://www.psm.sdcep.org.uk/topics/medical-emergencies-and-life-support/medical-emergency-drugs/", "publisher": "Scottish Dental Clinical Effectiveness Programme", "year": 2021, "li