+"""Guideline supersession graph.
+
+UK guidance is revised regularly, but withdrawn versions stay online and keep
+arriving through harvesting and research citations. The graph in
+`knowledge/supersession.yaml` describes which documents have been replaced and
+by what. At retrieval time a superseded passage is:
+
+  * demoted by a multiplicative penalty so current guidance ranks above it,
+  * annotated with the replacing guidance (resolved transitively, so a chain
+    A -> B -> C always points the clinician at C),
+  * marked in the prompt so the model is told not to present it as current.
+
+The graph is also validated on load: an unknown key, a missing replacement or a
+cycle is an error, because a broken supersession rule is a clinical safety
+issue rather than a cosmetic one.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date
+from functools import lru_cache
+
+from backend.app.domain import Chunk, RetrievedChunk
+from backend.app.knowledge import load
+
+_MATCH_KEYS = {"title_contains", "url_contains", "publisher_contains", "source", "doc_id", "published_before"}
+DEFAULT_PENALTY = 0.5
+
+
+@dataclass(frozen=True)
+class Replacement:
+    id: str
+    title: str
+    url: str
+
+
+@dataclass(frozen=True)
+class SupersessionRule:
+    id: str
+    match: dict
+    superseded_by: Replacement
+    effective: date | None
+    note: str
+    penalty: float = DEFAULT_PENALTY
+
+    def matches(self, chunk: Chunk) -> bool:
+        m = self.match
+        title = chunk.title.lower()
+        if "title_contains" in m and m["title_contains"].lower() not in title:
+            return False
+        if "url_contains" in m and m["url_contains"].lower() not in chunk.url.lower():
+            return False
+        if "publisher_contains" in m and m["publisher_contains"].lower() not in (chunk.publisher or "").lower():
+            return False
+        if "source" in m and chunk.source != m["source"]:
+            return False
+        if "doc_id" in m and chunk.doc_id != m["doc_id"]:
+            return False
+        # Undated documents are not assumed old: only a known year can supersede.
+        return "published_before" not in m or (chunk.published_year is not None
+                                                and chunk.published_year < int(m["published_before"]))
+
+
+class SupersessionGraph:
+    def __init__(self, rules: list[SupersessionRule]) -> None:
+        self.rules = rules
+        self._by_id = {r.id: r for r in rules}
+        self._validate()
+
+    @classmethod
+    def from_config(cls, data: dict) -> SupersessionGraph:
+        rules = []
+        for raw in data.get("rules", []):
+            unknown = set(raw["match"]) - _MATCH_KEYS
+            if unknown:
+                raise ValueError(f"Supersession rule {raw['id']} has unknown match keys: {sorted(unknown)}")
+            if not raw["match"]:
+                raise ValueError(f"Supersession rule {raw['id']} must match on at least one field")
+            replacement = raw["superseded_by"]
+            effective = raw.get("effective")
+            rules.append(SupersessionRule(
+                id=raw["id"], match=raw["match"],
+                superseded_by=Replacement(replacement["id"], replacement["title"], replacement["url"]),
+                effective=effective if isinstance(effective, date) else (
+                    date.fromisoformat(effective) if effective else None),
+                note=raw.get("note", ""), penalty=float(raw.get("penalty", DEFAULT_PENALTY)),
+            ))
+        return cls(rules)
+
+    def _validate(self) -> None:
+        for rule in self.rules:
+            if not 0 < rule.penalty <= 1:
+                raise ValueError(f"Supersession rule {rule.id} penalty must be in (0, 1]")
+            seen = {rule.id}
+            current = rule.superseded_by.id
+            while current in self._by_id:
+                if current in seen:
+                    raise ValueError(f"Supersession cycle through {current}")
+                seen.add(current)
+                current = self._by_id[current].superseded_by.id
+
+    def resolve(self, rule: SupersessionRule) -> Replacement:
+        """Follow the chain to the newest replacement."""
+        replacement = rule.superseded_by
+        while replacement.id in self._by_id:
+            replacement = self._by_id[replacement.id].superseded_by
+        return replacement
+
+    def find(self, chunk: Chunk) -> SupersessionRule | None:
+        return next((rule for rule in self.rules if rule.matches(chunk)), None)
+
+    def annotate(self, item: RetrievedChunk) -> bool:
+        """Mark and demote a retrieved passage if it is superseded. Returns True when it was."""
+        rule = self.find(item.chunk)
+        if rule is None:
+            return False
+        newest = self.resolve(rule)
+        item.superseded_by = {"rule": rule.id, "title": newest.title, "url": newest.url, "note": rule.note,
+                              "effective": rule.effective.isoformat() if rule.effective else None}
+        item.final_score *= rule.penalty
+        return True
+
+    def as_dict(self) -> list[dict]:
+        return [{"id": r.id, "match": r.match, "superseded_by": self.resolve(r).__dict__, "note": r.note,
+                 "effective": r.effective.isoformat() if r.effective else None, "penalty": r.penalty}
+                for r in self.rules]
+
+
+@lru_cache(maxsize=1)
+def default_graph() -> SupersessionGraph:
+    return SupersessionGraph.from_config(load("supersession"))
