+# Root Canon AI API image.
+#   docker build -t root-canon-api .                         # full models, Qdrant, Redis, all vendors
+#   docker build --build-arg EXTRAS=llm,cache -t rc-lite .   # small image for hashing embedder deployments
+FROM python:3.12-slim AS build
+ARG EXTRAS=all
+ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
+WORKDIR /src
+RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
+COPY pyproject.toml README.md ./
+COPY backend ./backend
+COPY ingestion ./ingestion
+COPY evaluation ./evaluation
+RUN python -m venv /opt/venv && /opt/venv/bin/pip install ".[${EXTRAS}]"
+
+FROM python:3.12-slim
+ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
+    RC_DATA_DIR=/data HF_HOME=/data/models
+RUN useradd --create-home --uid 10001 rootcanon && mkdir -p /data && chown rootcanon /data
+COPY --from=build /opt/venv /opt/venv
+WORKDIR /app
+COPY --chown=rootcanon backend ./backend
+COPY --chown=rootcanon ingestion ./ingestion
+COPY --chown=rootcanon evaluation ./evaluation
+USER rootcanon
+EXPOSE 8000
+HEALTHCHECK --interval=20s --timeout=3s --start-period=60s --retries=3 \
+  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).status == 200 else 1)"
+CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--workers", "2"]
