diff --git a/deploy/alerts.yml b/deploy/alerts.yml
new file mode 100644
index 0000000..636f386
--- /dev/null
+++ b/deploy/alerts.yml
@@ -0,0 +1,50 @@
+# Alerts a clinical safety officer and the on call engineer care about.
+groups:
+  - name: root_canon_clinical_safety
+    rules:
+      - alert: UnsupportedFiguresInAnswers
+        expr: increase(rc_unsupported_numbers_total[1h]) > 0
+        labels: { severity: page }
+        annotations:
+          summary: A generated answer contained a clinical figure not found in its cited sources.
+          description: Review the audit log for the affected request ids and the model in use.
+      - alert: LowFaithfulness
+        expr: histogram_quantile(0.1, sum(rate(rc_faithfulness_bucket[1h])) by (le)) < 0.6
+        for: 30m
+        labels: { severity: ticket }
+        annotations:
+          summary: The lowest decile of answers has weak claim support from cited passages.
+      - alert: AbstentionSpike
+        expr: >
+          sum(rate(rc_answers_total{outcome="abstained"}[30m]))
+          / clamp_min(sum(rate(rc_answers_total[30m])), 1e-9) > 0.4
+        for: 30m
+        labels: { severity: ticket }
+        annotations:
+          summary: More than 40 percent of questions are abstaining; the index may be empty or degraded.
+      - alert: SupersededGuidanceRetrieved
+        expr: increase(rc_superseded_sources_total[1d]) > 50
+        labels: { severity: ticket }
+        annotations:
+          summary: Superseded guidance is being retrieved often; consider removing old editions from the index.
+  - name: root_canon_service
+    rules:
+      - alert: ProviderFallbacks
+        expr: sum(increase(rc_provider_fallbacks_total[15m])) > 5
+        labels: { severity: ticket }
+        annotations:
+          summary: Answers are being served by fallback providers; the primary model may be degraded.
+      - alert: HighAnswerLatency
+        expr: histogram_quantile(0.95, sum(rate(rc_answer_latency_seconds_bucket[10m])) by (le)) > 16
+        for: 10m
+        labels: { severity: ticket }
+        annotations:
+          summary: 95th percentile answer latency is above 16 seconds.
+      - alert: ApiErrors
+        expr: >
+          sum(rate(rc_http_requests_total{status=~"5.."}[5m]))
+          / clamp_min(sum(rate(rc_http_requests_total[5m])), 1e-9) > 0.02
+        for: 5m
+        labels: { severity: page }
+        annotations:
+          summary: More than 2 percent of API requests are failing.
