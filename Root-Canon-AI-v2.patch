diff --git a/compose.yaml b/compose.yaml
new file mode 100644
index 0000000..afa0a78
--- /dev/null
+++ b/compose.yaml
@@ -0,0 +1,75 @@
+# Full Root Canon AI stack.
+#   make up                         API, Qdrant, Redis, interface, Prometheus, Grafana
+#   docker compose --profile local up -d   adds Ollama for fully on premises inference
+name: root-canon
+
+services:
+  api:
+    build: .
+    env_file:
+      - path: .env
+        required: false
+    environment:
+      RC_QDRANT_URL: http://qdrant:6333
+      RC_REDIS_URL: redis://redis:6379/0
+      RC_OLLAMA_BASE_URL: http://ollama:11434
+      RC_CORS_ORIGINS: http://localhost:8080
+    volumes: [rc_data:/data]
+    ports: ["8000:8000"]
+    depends_on:
+      qdrant: { condition: service_started }
+      redis: { condition: service_healthy }
+    restart: unless-stopped
+
+  frontend:
+    build:
+      context: ./frontend
+    ports: ["8080:80"]
+    depends_on: [api]
+    restart: unless-stopped
+
+  qdrant:
+    image: qdrant/qdrant:v1.12.4
+    volumes: [qdrant_data:/qdrant/storage]
+    ports: ["6333:6333"]
+    restart: unless-stopped
+
+  redis:
+    image: redis:7.4-alpine
+    command: ["redis-server", "--maxmemory", "256mb", "--maxmemory-policy", "allkeys-lru", "--save", ""]
+    healthcheck:
+      test: ["CMD", "redis-cli", "ping"]
+      interval: 5s
+      retries: 10
+    restart: unless-stopped
+
+  ollama:
+    image: ollama/ollama:0.5.4
+    profiles: [local]
+    volumes: [ollama_models:/root/.ollama]
+    ports: ["11434:11434"]
+    restart: unless-stopped
+
+  prometheus:
+    image: prom/prometheus:v2.55.1
+    volumes:
+      - ./deploy/prometheus.yml:/etc/prometheus/prometheus.yml:ro
+      - ./deploy/alerts.yml:/etc/prometheus/alerts.yml:ro
+    ports: ["9090:9090"]
+    depends_on: [api]
+
+  grafana:
+    image: grafana/grafana:11.3.1
+    environment:
+      GF_AUTH_ANONYMOUS_ENABLED: "true"
+      GF_AUTH_ANONYMOUS_ORG_ROLE: Viewer
+    volumes:
+      - ./deploy/grafana/provisioning:/etc/grafana/provisioning:ro
+      - ./deploy/grafana/dashboards:/var/lib/grafana/dashboards:ro
+    ports: ["3000:3000"]
+    depends_on: [prometheus]
+
+volumes:
+  rc_data:
+  qdrant_data:
+  ollama_models:
