+# Copy to .env and fill in what you need. Every RC_ setting is documented in
+# backend/app/config.py; list settings take comma separated values.
+
+# Environment: development allows the local UI without an API key.
+RC_ENV=development
+RC_LOG_LEVEL=INFO
+
+# Access control
+RC_API_KEYS=change_me_local_key
+RC_ADMIN_API_KEYS=
+RC_AUDIT_SALT=replace_with_a_long_random_secret
+RC_CORS_ORIGINS=http://localhost:5173
+
+# Language models: primary provider, then fallbacks, then the extractive safety net
+RC_LLM_PROVIDER=anthropic
+RC_LLM_FALLBACKS=openai
+ANTHROPIC_API_KEY=
+OPENAI_API_KEY=
+RC_OLLAMA_BASE_URL=http://localhost:11434
+RC_OLLAMA_MODEL=llama3.1:8b
+
+# Retrieval. For laptops without model weights use hashing, none and memory.
+RC_EMBEDDING_BACKEND=sentence_transformers
+RC_RERANKER_BACKEND=cross_encoder
+RC_VECTOR_BACKEND=qdrant
+RC_QDRANT_URL=http://localhost:6333
+RC_MIN_EVIDENCE_SCORE=0.20
+RC_MIN_QUERY_COVERAGE=0.20
+RC_MIN_FAITHFULNESS=0.5
+
+# Cache: Redis when reachable, otherwise an in process LRU of this size
+RC_REDIS_URL=redis://localhost:6379/0
+RC_MEMORY_CACHE_SIZE=512
+
+# Ingestion
+NCBI_API_KEY=
+NICE_SYNDICATION_API_KEY=
