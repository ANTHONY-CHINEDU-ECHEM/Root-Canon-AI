+name: CI
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true
+
+permissions:
+  contents: read
+
+jobs:
+  backend:
+    name: Backend (lint, types, tests, evaluation gate)
+    runs-on: ubuntu-latest
+    strategy:
+      matrix:
+        python: ["3.11", "3.12", "3.13"]
+    env:
+      RC_ENV: test
+      RC_EMBEDDING_BACKEND: hashing
+      RC_RERANKER_BACKEND: none
+      RC_VECTOR_BACKEND: memory
+      RC_REDIS_URL: ""
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python }}
+          cache: pip
+      - run: python -m pip install -e ".[dev]"
+      - name: Lint
+        run: python -m ruff check backend ingestion evaluation scripts tests
+      - name: README style and diagram sync
+        run: python -m scripts.build_readme --check
+      - name: Type check
+        run: python -m mypy
+      - name: Tests with coverage
+        run: python -m pytest --cov --cov-report=term --cov-report=xml
+      - name: Evaluation gate
+        run: python -m evaluation.run_eval --gate --out evaluation/results/ci.json --markdown evaluation/results/ci.md
+      - name: Publish evaluation summary
+        if: always() && matrix.python == '3.12'
+        run: cat evaluation/results/ci.md >> "$GITHUB_STEP_SUMMARY"
+      - uses: actions/upload-artifact@v4
+        if: always() && matrix.python == '3.12'
+        with:
+          name: evaluation-report
+          path: evaluation/results/ci.*
+
+  frontend:
+    name: Frontend (types and build)
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: frontend
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+      - run: npm ci
+      - run: npm run typecheck
+      - run: npm run build
+
+  containers:
+    name: Container images build
+    runs-on: ubuntu-latest
+    needs: [backend, frontend]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: docker/setup-buildx-action@v3
+      - name: API image (lite)
+        uses: docker/build-push-action@v6
+        with:
+          context: .
+          build-args: EXTRAS=llm,cache
+          push: false
+          tags: root-canon-api:ci
+          cache-from: type=gha
+          cache-to: type=gha,mode=max
+      - name: Interface image
+        uses: docker/build-push-action@v6
+        with:
+          context: ./frontend
+          push: false
+          tags: root-canon-frontend:ci
