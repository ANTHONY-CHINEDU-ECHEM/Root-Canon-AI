+// Export a consultation as Markdown clinical notes: questions, verified tool results, the cited
+// answer and a numbered source list, ready to paste into a record or a referral letter.
+import type { FinalEvent, Source, ToolCard } from "./api";
+
+interface ExportTurn {
+  question: string;
+  cards: ToolCard[];
+  sources: Source[];
+  final: FinalEvent | null;
+  emergency: string | null;
+}
+
+export function consultMarkdown(turns: ExportTurn[], now = new Date()): string {
+  const lines = [`# Root Canon AI consultation notes`, ``, `Exported ${now.toLocaleString("en-GB")}. Decision support only; confirm against the BNF and current guidance.`, ``];
+  turns.filter((t) => t.final).forEach((t, i) => {
+    lines.push(`## ${i + 1}. ${t.question}`, ``);
+    if (t.emergency) lines.push(`**Emergency:** ${t.emergency}`, ``);
+    for (const card of t.cards) lines.push(`> **${card.title}** (deterministic): ${card.summary}`, ``);
+    lines.push(t.final!.answer, ``);
+    if (t.sources.length) {
+      lines.push(`Sources:`);
+      for (const s of t.sources) lines.push(`${s.id}. ${s.title}${s.year ? ` (${s.year})` : ""}${s.superseded_by ? " [superseded]" : ""} ${s.url}`);
+      lines.push(``);
+    }
+  });
+  return lines.join("\n");
+}
+
+export function exportConsult(turns: ExportTurn[]): void {
+  const blob = new Blob([consultMarkdown(turns)], { type: "text/markdown" });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = `root-canon-consult-${new Date().toISOString().slice(0, 10)}.md`;
+  link.click();
+  URL.revokeObjectURL(url);
+}
