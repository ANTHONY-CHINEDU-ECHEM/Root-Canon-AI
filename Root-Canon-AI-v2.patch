+# Guideline supersession graph.
+#
+# Clinical guidance is revised, but older versions stay online and keep being
+# harvested. A rule here marks matching documents as superseded so retrieval
+# demotes them and the interface labels them, which stops withdrawn advice
+# being presented as the current UK standard of care.
+#
+# A document matches a rule when every condition given in `match` holds.
+# `superseded_by` may itself be the subject of a later rule; chains are
+# resolved transitively to the newest guidance.
+
+reviewed: "2026-10"
+
+rules:
+  - id: dboh-third-edition
+    match:
+      title_contains: delivering better oral health
+      published_before: 2021
+    superseded_by:
+      id: dboh-fourth-edition
+      title: Delivering better oral health, 4th edition (2021)
+      url: https://www.gov.uk/government/publications/delivering-better-oral-health-an-evidence-based-toolkit-for-prevention
+    effective: 2021-09-09
+    note: The 2021 edition replaced the 2017 and 2014 versions of the toolkit.
+
+  - id: sdcep-prescribing-third-edition-original
+    match:
+      title_contains: drug prescribing for dentistry
+      published_before: 2021
+    superseded_by:
+      id: sdcep-prescribing-2021-update
+      title: SDCEP Drug Prescribing for Dentistry, 2021 update
+      url: https://sdcep.org.uk/news/update-to-drug-prescribing-guidance-now-available/
+    effective: 2021-01-01
+    note: The 2021 update made phenoxymethylpenicillin the first choice antibiotic for dento alveolar infection.
+
+  - id: rcuk-anaphylaxis-2008
+    match:
+      title_contains: anaphyla
+      publisher_contains: resuscitation council
+      published_before: 2021
+    superseded_by:
+      id: rcuk-anaphylaxis-2021
+      title: Resuscitation Council UK, Emergency treatment of anaphylaxis (2021)
+      url: https://www.resus.org.uk/library/additional-guidance/guidance-anaphylaxis/emergency-treatment
+    effective: 2021-05-01
+    note: The 2021 guidance replaced the 2008 anaphylaxis algorithm.
+
+  - id: nice-cg64-2008-wording
+    match:
+      title_contains: cg64
+      published_before: 2016
+    superseded_by:
+      id: nice-cg64-2016
+      title: NICE CG64 as amended in 2016
+      url: https://www.nice.org.uk/guidance/cg64
+    effective: 2016-07-08
+    note: The 2016 amendment changed the recommendation to say prophylaxis is not recommended routinely.
