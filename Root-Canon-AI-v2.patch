@@ -0,0 +1,131 @@
+"""Provider router with ordered fallback and circuit breakers.
+
+A clinician should never see a server error because one vendor is having a bad
+minute. The router tries each configured provider in order. Any exception from
+a provider (an SDK API error, a timeout, a refused connection) counts as a
+failure; after `failure_threshold` consecutive failures that provider's circuit
+opens and it is skipped for `cooldown_seconds`, after which one trial request
+is allowed through. The chain always ends with the extractive generator, which
+cannot fail, so an answer is always grounded in retrieved text.
+
+Streaming can only fall back before the first token is sent; after that the
+partial answer is kept and the error is surfaced in the final event rather
+than mixing two models' text.
+"""
+
+from __future__ import annotations
+
+import time
+from collections.abc import AsyncIterator
+from dataclasses import dataclass, field
+
+from backend.app.llm.base import LLMMessage, LLMProvider, LLMResponse, LLMUnavailableError
+from backend.app.logging_setup import get_logger
+from backend.app.observability import metrics
+
+log = get_logger("llm.router")
+
+
+@dataclass
+class CircuitBreaker:
+    failure_threshold: int = 3
+    cooldown_seconds: float = 30.0
+    failures: int = 0
+    opened_at: float | None = None
+    clock: object = field(default=time.monotonic, repr=False)
+
+    def _now(self) -> float:
+        return self.clock()  # type: ignore[operator]
+
+    @property
+    def state(self) -> str:
+        if self.opened_at is None:
+            return "closed"
+        return "half_open" if self._now() - self.opened_at >= self.cooldown_seconds else "open"
+
+    def allow(self) -> bool:
+        return self.state != "open"
+
+    def success(self) -> None:
+        self.failures, self.opened_at = 0, None
+
+    def failure(self) -> None:
+        self.failures += 1
+        if self.failures >= self.failure_threshold or self.state == "half_open":
+            self.opened_at = self._now()
+
+
+class ProviderRouter(LLMProvider):
+    """Presents a chain of providers as a single provider."""
+
+    def __init__(self, providers: list[LLMProvider], failure_threshold: int = 3,
+                 cooldown_seconds: float = 30.0) -> None:
+        if not providers:
+            raise ValueError("ProviderRouter needs at least one provider")
+        self.providers = providers
+        self.breakers = {p.name: CircuitBreaker(failure_threshold, cooldown_seconds) for p in providers}
+        self.last_used: LLMProvider = providers[0]
+
+    @property
+    def name(self) -> str:  # type: ignore[override]
+        return self.providers[0].name
+
+    @property
+    def model(self) -> str:  # type: ignore[override]
+        return getattr(self.providers[0], "model", self.providers[0].name)
+
+    def _candidates(self) -> list[LLMProvider]:
+        allowed = [p for p in self.providers if self.breakers[p.name].allow()]
+        # The final provider is the safety net and is always tried.
+        return allowed if allowed and allowed[-1] is self.providers[-1] else [*allowed, self.providers[-1]]
+
+    def _failed(self, provider: LLMProvider, exc: BaseException) -> None:
+        self.breakers[provider.name].failure()
+        metrics.PROVIDER_FAILURES.labels(provider.name).inc()
+        log.warning("provider_failed", provider=provider.name, error=type(exc).__name__,
+                    state=self.breakers[provider.name].state)
+
+    async def complete(self, system: str, messages: list[LLMMessage], *,
+                       temperature: float, max_tokens: int) -> LLMResponse:
+        last_error: BaseException | None = None
+        for index, provider in enumerate(self._candidates()):
+            try:
+                response = await provider.complete(system, messages, temperature=temperature, max_tokens=max_tokens)
+            except Exception as exc:
+                self._failed(provider, exc)
+                last_error = exc
+                continue
+            self.breakers[provider.name].success()
+            self.last_used = provider
+            if index:
+                metrics.PROVIDER_FALLBACKS.labels(provider.name).inc()
+            metrics.observe_tokens(response)
+            return response
+        raise LLMUnavailableError(f"All providers failed: {last_error}")
+
+    async def stream(self, system: str, messages: list[LLMMessage], *,
+                     temperature: float, max_tokens: int) -> AsyncIterator[str]:
+        last_error: BaseException | None = None
+        for index, provider in enumerate(self._candidates()):
+            started = False
+            try:
+                async for token in provider.stream(system, messages, temperature=temperature, max_tokens=max_tokens):
+                    started = True
+                    self.last_used = provider
+                    yield token
+            except Exception as exc:
+                self._failed(provider, exc)
+                last_error = exc
+                if started:
+                    raise LLMUnavailableError(f"{provider.name} failed mid stream: {exc}") from exc
+                continue
+            self.breakers[provider.name].success()
+            self.last_used = provider
+            if index:
+                metrics.PROVIDER_FALLBACKS.labels(provider.name).inc()
+            return
+        raise LLMUnavailableError(f"All providers failed: {last_error}")
+
+    def status(self) -> list[dict]:
+        return [{"provider": p.name, "model": getattr(p, "model", p.name), "circuit": self.breakers[p.name].state,
+                 "consecutive_failures": self.breakers[p.name].failures} for p in self.providers]
