+  for (const p of parts) { acc += p; el.innerHTML = acc + '<span class="caret"></span>'; await new Promise(r => setTimeout(r, p.trim() ? 14 : 0)); }
+  el.innerHTML = acc;
+}
+
+async function ask(raw) {
+  raw = raw.trim(); if (!raw || busy) return;
+  busy = true; $("send").disabled = true;
+  if (messages.querySelector(".empty")) messages.innerHTML = "";
+  const t0 = performance.now();
+  const { text, found } = redact(raw);
+  const redNote = Object.keys(found).length ? `<span class="redact">Redacted before processing: ${Object.entries(found).map(([k, v]) => `${k}${v > 1 ? " ×" + v : ""}`).join(", ")}</span>` : "";
+  messages.insertAdjacentHTML("beforeend", `<div class="msg-q">${esc(text)}${redNote}</div>`);
+  const wrap = document.createElement("div"); wrap.className = "msg-a";
+  const prov = document.querySelector('input[name="prov"]:checked').value;
+  const provName = { anthropic: "Claude", openai: "OpenAI", ollama: "Ollama" }[prov];
+  wrap.innerHTML = `<div class="who"><b>Root Canon AI</b><span>demo mode · extractive · deployed with ${provName}</span></div>`;
+  messages.appendChild(wrap);
+
+  const triage = EMERGENCY.filter(r => r.re.some(re => re.test(text)));
+  if (triage.length) wrap.insertAdjacentHTML("beforeend", triage.map(r => `<div class="banner" role="alert"><strong>${esc(r.title)}</strong><span>${esc(r.action)}</span></div>`).join(""));
+
+  const ctx = text.split(/\s+/).length < 8 && history.length ? history.slice(-1)[0] + " " : "";
+  if (!triage.length && !DENTAL.test(text) && !DENTAL.test(ctx)) {
+    wrap.insertAdjacentHTML("beforeend", `<div class="answer"><p>Root Canon AI answers dental clinical questions and the medical issues that change dental care. Please rephrase your question in a dental context.</p></div>`);
+    renderSources([]); renderTrace(0, 0, Math.round(performance.now() - t0)); busy = false; $("send").disabled = false; return;
+  }
+  const query = ctx + text + " " + triage.map(r => r.hint).join(" ");
+  const { results, scored } = retrieve(query, { guide: $("fGuide").checked, recent: $("fRecent").checked });
+  renderSources(results);
+  const out = results.length && results[0].score > .25 ? compose(query, results) : null;
+  const ans = document.createElement("div"); ans.className = "answer"; wrap.appendChild(ans);
+  if (!out) {
+    ans.innerHTML = `<p>I could not find enough evidence in the knowledge base to answer this safely. Please consult the current BNF, SDCEP guidance or NICE directly, or add more clinical detail.</p>`;
+    wrap.insertAdjacentHTML("beforeend", `<div class="checks"><span class="chip warn">Abstained: evidence below threshold</span></div>`);
+  } else {
+    let html = `<p>${withCites(out.lead.s, out.lead.id)}</p>`;
+    if (out.rest.length) html += `<ul>${out.rest.map(r => `<li>${withCites(r.s, r.id)}</li>`).join("")}</ul>`;
+    html += `<p class="judgement"><b>Clinical judgement:</b> confirm ${esc(out.factors.join(", "))} before acting.</p>`;
+    await typeInto(ans, html);
+    const ms = Math.round(performance.now() - t0);
+    wrap.insertAdjacentHTML("beforeend", `<div class="checks">
+      <span class="chip ok">Citation coverage 100%</span>
+      <span class="chip ${out.unsupported.length ? "warn" : "ok"}">${out.unsupported.length ? "Unverified figures: " + esc(out.unsupported.join(", ")) : "All figures matched to sources"}</span>
+      <span class="chip">${out.cited.length} of ${results.length} sources cited</span></div>`);
+    renderTrace(scored, out.cited.length, ms);
+  }
+  if (!out) renderTrace(scored, 0, Math.round(performance.now() - t0));
+  history.push(text);
+  wrap.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "nearest" });
+  busy = false; $("send").disabled = false;
+}
+
+$("composer").addEventListener("submit", e => { e.preventDefault(); const v = $("q").value; $("q").value = ""; ask(v); });
+$("q").addEventListener("keydown", e => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); $("composer").requestSubmit(); } });
+
+/* ---------- tabs ---------- */
+document.querySelector("nav.tabs").addEventListener("click", e => {
+  const b = e.target.closest("button[data-view]"); if (!b) return;
+  document.querySelectorAll("nav.tabs button").forEach(x => x.setAttribute("aria-selected", x === b));
+  document.querySelectorAll(".view").forEach(v => v.hidden = v.id !== "view-" + b.dataset.view);
+});
+
+/* ---------- clinical tools ---------- */
+const F = DATA.formulary;
+const srcLink = k => F.sources[k] ? `<a href="${F.sources[k]}" target="_blank" rel="noopener">source</a>` : "";
+$("rDrug").innerHTML = Object.keys(F.regimens).map(k => `<option value="${k}">${k[0].toUpperCase() + k.slice(1)}</option>`).join("");
+function regimen() {
+  const k = $("rDrug").value, age = parseFloat($("rAge").value), e = F.regimens[k];
+  let dose, freq, pop;
+  if (!isNaN(age) && age < 18) {
+    const band = (e.child_bands || []).find(b => b.min_age_years <= age && age < b.max_age_years);
+    if (!band) { $("rOut").innerHTML = `<div class="ix moderate"><b>No paediatric band on file</b><span>Consult the BNFC for ${esc(k)} at age ${age}.</span></div>`; return; }
+    dose = band.dose; freq = band.frequency; pop = `Child, ${age} years`;
+  } else { dose = e.adult.dose; freq = e.adult.frequency; pop = "Adult"; }
+  $("rOut").innerHTML = `<div class="big">${esc(dose)}</div>
+    <dl class="kv"><dt>Frequency</dt><dd>${esc(freq)}</dd><dt>Duration</dt><dd>${esc(e.adult.duration || "as directed")}</dd><dt>Population</dt><dd>${pop}</dd><dt>Indication</dt><dd>${esc(e.indication)}</dd><dt>Note</dt><dd>${esc(e.note)}</dd></dl>
+    <div class="verify">Reference only. Confirm against the current BNF or BNFC. ${srcLink(e.source)} · reviewed ${F.reviewed}</div>`;
+}
+["rDrug", "rAge"].forEach(id => $(id).addEventListener("input", regimen)); regimen();
+
+$("laProd").innerHTML = F.local_anaesthetics.map((p, i) => `<option value="${i}">${esc(p.name)}</option>`).join("");
+function la() {
+  const p = F.local_anaesthetics[+$("laProd").value], w = parseFloat($("laWt").value);
+  if (isNaN(w) || w < 3 || w > 250) { $("laOut").innerHTML = `<p class="note" style="margin:0">Enter a weight between 3 and 250 kg.</p>`; return; }
+  const byWeight = p.max_mg_per_kg * w, mg = Math.min(byWeight, p.absolute_max_mg), ml = mg / p.mg_per_ml, carts = ml / p.cartridge_ml;
+  const capped = byWeight > p.absolute_max_mg;
+  $("laOut").innerHTML = `<div class="big">${carts.toFixed(1)} cartridges</div>
+    <dl class="kv"><dt>Maximum</dt><dd class="mono">${mg.toFixed(1)} mg · ${ml.toFixed(2)} mL</dd><dt>Basis</dt><dd>${p.max_mg_per_kg} mg/kg${capped ? `, capped at the ${p.absolute_max_mg} mg ceiling` : ""}</dd></dl>
+    <div class="meter" aria-hidden="true"><i style="width:${Math.min(100, mg / p.absolute_max_mg * 100)}%"></i></div>
+    <div class="verify">Share of the absolute ceiling. Reference values; confirm against the product SmPC and reduce for medical risk.</div>`;
+}
+["laProd", "laWt"].forEach(id => $(id).addEventListener("input", la)); la();
+
+function adr() {
+  const a = parseFloat($("adAge").value), e = F.emergency.adrenaline_anaphylaxis;
+  const band = e.age_bands.find(b => b.min_age_years <= a && a < b.max_age_years);
+  $("adOut").innerHTML = band ? `<div class="big">${esc(band.dose)}</div><dl class="kv"><dt>Route</dt><dd>Intramuscular, anterolateral thigh</dd><dt>Repeat</dt><dd>${esc(e.repeat)}</dd></dl><div class="verify">Call 999 and use the ABCDE approach. ${srcLink(e.source)}</div>` : `<p class="note">Enter an age.</p>`;
+}
+$("adAge").addEventListener("input", adr); adr();
+
+const ixNames = [...new Set(F.interactions.flatMap(r => [r.a, r.b]))].sort();
+$("ixDrugs").innerHTML = ixNames.map(n => `<label><input type="checkbox" id="ix-${n}" value="${n}" ${["metronidazole", "warfarin"].includes(n) ? "checked" : ""}><span>${n}</span></label>`).join("");
+function ix() {
+  const sel = [...document.querySelectorAll("#ixDrugs input:checked")].map(i => i.value);
+  const hits = F.interactions.filter(r => sel.includes(r.a) && sel.includes(r.b)).sort((a, b) => (a.severity === "major" ? 0 : 1) - (b.severity === "major" ? 0 : 1));
+  $("ixOut").innerHTML = sel.length < 2 ? `<p class="note" style="margin:0">Select at least two medicines.</p>` :
+    (hits.length ? hits.map(h => `<div class="ix ${h.severity}"><b>${h.severity === "major" ? "Major" : "Moderate"}: ${esc(h.a)} with ${esc(h.b)}</b><span>${esc(h.effect)}</span></div>`).join("") : `<div class="ix" style="background:var(--guide-soft)"><b style="color:var(--guide)">No interaction in the curated dental set</b><span>This is not proof of safety. Check the BNF interactions appendix.</span></div>`);
+}
+$("ixDrugs").addEventListener("change", ix); ix();
+
+/* ---------- library ---------- */
+$("libRows").innerHTML = DATA.docs.map(d => `<tr><td><a href="${d.url}" target="_blank" rel="noopener">${esc(d.title)}</a></td><td>${esc(d.publisher || "")}</td><td><span class="ev ${d.evidence_level === 6 ? "ev-6" : "ev-low"}">${esc(d.evidence)}</span></td><td class="num">${d.year || ""}</td><td class="mono">${esc(d.licence)}</td><td class="num">${d.passages}</td></tr>`).join("");
+</script>
