+class SlidingWindowLimiter:
+    """Per identity sliding window. Memory is bounded by pruning idle identities."""
+
+    def __init__(self, window_seconds: float = 60.0, max_identities: int = 10_000) -> None:
+        self.window = window_seconds
+        self.max_identities = max_identities
+        self._hits: dict[str, deque[float]] = defaultdict(deque)
+        self._lock = Lock()
+
+    def hit(self, identity: str, limit: int, now: float | None = None) -> float | None:
+        """Record a request. Returns None when allowed, or seconds to wait when limited."""
+        now = time.monotonic() if now is None else now
+        with self._lock:
+            window = self._hits[identity]
+            while window and now - window[0] > self.window:
+                window.popleft()
+            if len(window) >= limit:
+                return max(0.0, self.window - (now - window[0]))
+            window.append(now)
+            if len(self._hits) > self.max_identities:
+                for key in [k for k, v in self._hits.items() if not v or now - v[-1] > self.window]:
+                    del self._hits[key]
+            return None
+
+    def reset(self) -> None:
+        with self._lock:
+            self._hits.clear()
+
