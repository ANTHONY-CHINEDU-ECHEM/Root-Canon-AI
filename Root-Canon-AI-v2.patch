+# Medication safety screen rules.
+#
+# These rules raise flags, never doses. They fire when the medicines a dentist
+# plans to prescribe meet the patient's medicines, allergies or conditions as
+# described in the de identified patient context. Each flag links to the UK
+# guidance a clinician should read before acting.
+
+reviewed: "2026-10"
+
+sources:
+  sdcep_anticoagulants: https://www.sdcep.org.uk/published-guidance/anticoagulants-and-antiplatelets/
+  sdcep_mronj: https://www.sdcep.org.uk/published-guidance/medication-related-osteonecrosis-of-the-jaw/
+  sdcep_prescribing: https://sdcepdentalprescribing.nhs.scot/
+  sdcep_ibuprofen: https://sdcepdentalprescribing.nhs.scot/guidance/odontogenic-pain/analgesics/ibuprofen/
+  bnf: https://bnf.nice.org.uk/
+
+# Rules keyed on what the patient already takes (drug classes from lexicon.yaml).
+patient_medicines:
+  - id: anticoagulated
+    classes: [vitamin_k_antagonists, doacs]
+    severity: major
+    title: Patient is anticoagulated
+    message: >-
+      Plan for bleeding risk before any invasive treatment. Follow the SDCEP anticoagulant guidance for INR
+      checks, DOAC dose timing and local haemostatic measures, and avoid NSAIDs for analgesia.
+    source: sdcep_anticoagulants
+  - id: antiplatelet
+    classes: [antiplatelets]
+    severity: moderate
+    title: Patient takes an antiplatelet drug
+    message: >-
+      Do not interrupt antiplatelet therapy before dental treatment. Expect prolonged bleeding and use local
+      measures such as packing and suturing.
+    source: sdcep_anticoagulants
+  - id: antiresorptive
+    classes: [antiresorptives]
+    severity: moderate
+    title: Medication related osteonecrosis of the jaw risk
+    message: >-
+      Assess MRONJ risk (indication, duration, glucocorticoids) before extractions or other bone invasive
+      treatment. Do not advise the patient to stop the drug.
+    source: sdcep_mronj
+
+# Rules keyed on the planned prescription and a patient condition or allergy.
+conditions:
+  - id: penicillin_allergy
+    planned_classes: [penicillins]
+    patterns: ["penicillin allerg", "allerg(y|ic) to penicillin", "allerg(y|ic) to amoxicillin", "pen allergy"]
+    severity: contraindicated
+    title: Penicillin allergy recorded
+    message: >-
+      A penicillin is planned but the patient context records a penicillin allergy. Choose a non penicillin
+      alternative from the SDCEP guidance and confirm the nature of the allergy.
+    source: sdcep_prescribing
+  - id: nsaid_asthma
+    planned_classes: [nsaids]
+    patterns: ["asthma"]
+    severity: caution
+    title: NSAID with asthma
+    message: >-
+      NSAIDs can provoke bronchospasm in some people with asthma. Ask about previous NSAID tolerance or
+      prefer paracetamol.
+    source: sdcep_ibuprofen
+  - id: nsaid_pregnancy
+    planned_classes: [nsaids]
+    patterns: ["pregnan"]
+    severity: caution
+    title: NSAID in pregnancy
+    message: >-
+      Avoid NSAIDs in pregnancy unless the benefit outweighs the risk, and avoid them in the third trimester.
+      Paracetamol is usually preferred.
+    source: sdcep_ibuprofen
+  - id: nsaid_renal
+    planned_classes: [nsaids]
+    patterns: ["renal impairment", "kidney disease", "ckd", "renal failure"]
+    severity: caution
+    title: NSAID with renal impairment
+    message: Use NSAIDs with caution or avoid them in renal impairment; check the BNF.
+    source: bnf
+  - id: nsaid_peptic_ulcer
+    planned_classes: [nsaids]
+    patterns: ["peptic ulcer", "stomach ulcer", "gastric ulcer", "gi bleed"]
+    severity: caution
+    title: NSAID with peptic ulcer history
+    message: NSAIDs are contraindicated with active peptic ulceration or a history of it; prefer paracetamol.
+    source: bnf
